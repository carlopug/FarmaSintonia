<section class="mb-4">
  <h2 class="h5">Librerie di terze parti</h2>
  <div class="table-responsive">
    <table class="table">
      <thead><tr><th>Libreria</th><th>Uso</th><th>Licenza</th></tr></thead>
      <tbody>
        <tr><td>Slim Framework</td><td>Routing dell'applicazione</td><td>MIT</td></tr>
        <tr><td>slim/psr7</td><td>Implementazione PSR-7</td><td>MIT</td></tr>
        <tr><td>Twig</td><td>Motore di template</td><td>BSD-3-Clause</td></tr>
