{
    "name": "carlopug/farmasintonia",
    "description": "Verifica di compatibilita tra piu farmaci e riepilogo degli effetti collaterali comuni, sulla base dei documenti ufficiali AIFA (RCP/FI).",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Carlo Puglisi"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-iconv": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "slim/twig-view": "^3.4",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.9",
        "smalot/pdfparser": "^2.11",
        "mpdf/mpdf": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "FarmaSintonia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FarmaSintonia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
