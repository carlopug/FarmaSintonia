# Copiare in .env (mai committato) e valorizzare per l'ambiente locale/VPS.

APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=farmasintonia
DB_USER=farmasintonia
DB_PASSWORD=

# Chiave per le chiamate all'API OpenAI (Services/LlmSintesi.php).
# Lasciare vuota per forzare il fallback alla sola analisi deterministica.
OPENAI_API_KEY=

# Modello OpenAI da usare per la sintesi (deve supportare Structured
# Outputs sull'endpoint /v1/chat/completions). Verificare che sia
# disponibile sull'account/progetto OpenAI in uso.
OPENAI_MODEL=gpt-5.6-luna
